# ── Copy this to .env and fill in your keys ──

# Finnhub — news only (free tier)
# Get key at: https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key_here

# Tradier — paper trading
# Get sandbox token at: https://developer.tradier.com
# Set TRADIER_PAPER=false to switch to live trading (use live token + account)
TRADIER_ACCESS_TOKEN=your_sandbox_token_here
TRADIER_ACCOUNT_ID=your_account_id_here
TRADIER_PAPER=true

# Risk limits
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.03
